#!/bin/bash
# Remove Patina chrome and the plugin.
set -euo pipefail

PLUGIN_ID="payton.patina"
PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
SCRIPT="$PLUGINS_DIR/$PLUGIN_ID/scripts/omarchy-patina"

if [[ -x $SCRIPT ]]; then
  exec "$SCRIPT" unapply --purge
fi

echo "omarchy-patina: plugin is not installed" >&2
exit 1
