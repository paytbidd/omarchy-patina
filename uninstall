#!/bin/bash
# Remove Polish chrome and the plugin.
set -euo pipefail

PLUGIN_ID="payton.polish"
PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
SCRIPT="$PLUGINS_DIR/$PLUGIN_ID/scripts/omarchy-polish"

if [[ -x $SCRIPT ]]; then
  exec "$SCRIPT" unapply --purge
fi

echo "omarchy-polish: plugin is not installed" >&2
exit 1
