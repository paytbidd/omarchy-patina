#!/bin/bash
# Apply, toggle, or remove Polish window chrome on this Omarchy machine.

set -euo pipefail

PLUGIN_ID="payton.polish"
HYPR_MARK_BEGIN="-- omarchy-polish begin"
HYPR_MARK_END="-- omarchy-polish end"
MENU_ID="style.polish"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PLUGIN_DIR=$(cd -- "$(dirname "$SCRIPT_DIR")" && pwd)
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
POLISH_TOML="$CONFIG_HOME/omarchy/polish.toml"
TWEAKS_TOML="$CONFIG_HOME/omarchy/theme-tweaks.toml"
MENU_FILE="$CONFIG_HOME/omarchy/extensions/omarchy-menu.jsonc"
HYPR_DIR="$CONFIG_HOME/hypr"
HYPRLAND_LUA="$HYPR_DIR/hyprland.lua"
HYPR_SNIPPET="$HYPR_DIR/polish.lua"
LOCAL_BIN="$HOME/.local/bin"
HOOK_DEST="$CONFIG_HOME/omarchy/hooks/theme-set.d/polish"
STOCK_LOOKNFEEL="/usr/share/omarchy/config/hypr/looknfeel.lua"

fail() {
  echo "omarchy-polish: $*" >&2
  exit 1
}

notify() {
  local msg="$1"
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send "$msg" -t 1800 >/dev/null 2>&1 || true
}

reload_hypr() {
  hyprctl reload >/dev/null 2>&1 || true
}

applied_now() {
  [[ -f $POLISH_TOML ]] || return 1
  python3 - "$POLISH_TOML" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
in_root = True
for raw in path.read_text().splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("["):
        in_root = False
        continue
    if in_root and line.split("=", 1)[0].strip() == "applied":
        value = line.split("=", 1)[1].split("#", 1)[0].strip()
        sys.exit(0 if value == "true" else 1)
sys.exit(1)
PY
}

set_applied() {
  local value="$1"
  mkdir -p "$(dirname "$POLISH_TOML")"
  python3 - "$POLISH_TOML" "$value" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
val = sys.argv[2]
text = path.read_text() if path.exists() else ""
lines = text.splitlines(keepends=True)
out = []
done = False
seen_section = False
for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and not stripped.startswith("[."):
        if not done and not seen_section:
            out.append(f"applied = {val}\n")
            done = True
        seen_section = True
        out.append(line)
        continue
    if stripped.startswith("applied") and "=" in stripped and not seen_section:
        if not done:
            prefix = line[: len(line) - len(line.lstrip())]
            newline = "\n" if line.endswith("\n") else ""
            out.append(f"{prefix}applied = {val}{newline}")
            done = True
        continue
    out.append(line)
if not done:
    body = "".join(out)
    extra = f"applied = {val}\n"
    if body and not body.endswith("\n"):
        extra = "\n" + extra
    out.append(extra)
path.write_text("".join(out))
PY
}

ensure_polish_toml() {
  mkdir -p "$(dirname "$POLISH_TOML")"
  if [[ -f $POLISH_TOML ]]; then
    return
  fi
  if [[ -f $PLUGIN_DIR/config/polish.toml ]]; then
    cp "$PLUGIN_DIR/config/polish.toml" "$POLISH_TOML"
  else
    printf 'applied = true\n' >"$POLISH_TOML"
  fi
}

migrate_theme_tweaks() {
  [[ -f $TWEAKS_TOML ]] || return 0
  python3 - "$TWEAKS_TOML" "$POLISH_TOML" <<'PY'
import pathlib, sys

tweaks_path = pathlib.Path(sys.argv[1])
polish_path = pathlib.Path(sys.argv[2])
text = tweaks_path.read_text()
chrome_keys = {
    "rounding", "border_size", "gaps_out_top", "gaps_out_right",
    "gaps_out_bottom", "gaps_out_left", "inactive_mix", "saturate_accent",
    "glow", "glow_range", "glow_power", "glow_alpha", "inner_glow_range",
    "inner_glow_alpha",
}
# Keep auto-switch where theme-auto already looks. Drop chrome keys so
# looknfeel.lua is no longer the source of truth.
kept = []
in_auto = False
had_chrome = False
for raw in text.splitlines(keepends=True):
    stripped = raw.strip()
    if stripped.startswith("["):
        name = stripped.strip("[]").strip()
        in_auto = name == "auto"
        kept.append(raw)
        continue
    key = stripped.split("=", 1)[0].strip() if "=" in stripped else ""
    if not in_auto and key in chrome_keys:
        had_chrome = True
        continue
    if not in_auto and key == "applied":
        continue
    kept.append(raw)

if had_chrome:
    body = "".join(kept)
    header = (
        "# Auto light/dark theme swap at sunrise and sunset.\n"
        "# Window chrome lives in polish.toml (Style → Polish).\n"
    )
    if "polish.toml" not in body:
        body = header + "\n" + body.lstrip("\n")
    tweaks_path.write_text(body)
PY
}

looknfeel_has_old_recipe() {
  [[ -f $HYPR_DIR/looknfeel.lua ]] || return 1
  grep -q "theme-tweaks.toml\|omarchy-polish\|parse_simple_toml" "$HYPR_DIR/looknfeel.lua"
}

restore_stock_looknfeel() {
  looknfeel_has_old_recipe || return 0
  [[ -f $STOCK_LOOKNFEEL ]] || return 0
  local bak="$HYPR_DIR/looknfeel.lua.bak.polish.$(date +%s)"
  cp "$HYPR_DIR/looknfeel.lua" "$bak"
  cp "$STOCK_LOOKNFEEL" "$HYPR_DIR/looknfeel.lua"
  echo "Restored stock looknfeel.lua (backup $bak)"
}

ensure_hypr_snippet() {
  mkdir -p "$HYPR_DIR"
  [[ -f $PLUGIN_DIR/hypr/polish.lua ]] || fail "missing $PLUGIN_DIR/hypr/polish.lua"
  cp "$PLUGIN_DIR/hypr/polish.lua" "$HYPR_SNIPPET"
  [[ -f $HYPRLAND_LUA ]] || fail "missing $HYPRLAND_LUA"

  python3 - "$HYPRLAND_LUA" "$HYPR_MARK_BEGIN" "$HYPR_MARK_END" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
begin, end = sys.argv[2], sys.argv[3]
lines = path.read_text().splitlines(keepends=True)
out = []
i = 0
while i < len(lines):
    line = lines[i]
    if begin in line:
        i += 1
        while i < len(lines) and end not in lines[i]:
            i += 1
        if i < len(lines):
            i += 1
        continue
    out.append(line)
    i += 1
text = "".join(out).rstrip() + "\n"
block = f"\n{begin}\nrequire(\"hypr.polish\")\n{end}\n"
if 'require("hypr.polish")' not in text:
    text = text.rstrip() + "\n" + block
path.write_text(text)
PY
}

remove_hypr_snippet() {
  rm -f "$HYPR_SNIPPET"
  [[ -f $HYPRLAND_LUA ]] || return 0
  python3 - "$HYPRLAND_LUA" "$HYPR_MARK_BEGIN" "$HYPR_MARK_END" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
begin, end = sys.argv[2], sys.argv[3]
lines = path.read_text().splitlines(keepends=True)
out, skipping = [], False
for line in lines:
    if begin in line:
        skipping = True
        continue
    if skipping:
        if end in line:
            skipping = False
        continue
    out.append(line)
path.write_text("".join(out))
PY
}

install_cli_link() {
  mkdir -p "$LOCAL_BIN"
  ln -sfn "$PLUGIN_DIR/scripts/omarchy-polish" "$LOCAL_BIN/omarchy-polish"
  # Old Smart Tweaks command name.
  cat >"$LOCAL_BIN/omarchy-theme-tweaks" <<'WRAP'
#!/bin/bash
# Back-compat for the old Smart Tweaks command name.
cmd="${1:-toggle}"
shift || true
case "$cmd" in
  apply | on) exec "$(dirname "$0")/omarchy-polish" on "$@" ;;
  *) exec "$(dirname "$0")/omarchy-polish" "$cmd" "$@" ;;
esac
WRAP
  chmod 755 "$LOCAL_BIN/omarchy-theme-tweaks"
}

remove_cli_link() {
  if [[ -L $LOCAL_BIN/omarchy-polish ]]; then
    local target
    target=$(readlink -f "$LOCAL_BIN/omarchy-polish" || true)
    if [[ $target == *"/payton.polish/"* || $target == *"/omarchy-polish/"* ]]; then
      rm -f "$LOCAL_BIN/omarchy-polish"
    fi
  fi
  if [[ -f $LOCAL_BIN/omarchy-theme-tweaks ]] && grep -q omarchy-polish "$LOCAL_BIN/omarchy-theme-tweaks"; then
    rm -f "$LOCAL_BIN/omarchy-theme-tweaks"
  fi
}

install_hook() {
  local src="$PLUGIN_DIR/hooks/polish"
  [[ -f $src ]] || fail "missing $src"
  mkdir -p "$(dirname "$HOOK_DEST")"
  cp "$src" "$HOOK_DEST"
  chmod 755 "$HOOK_DEST"
}

remove_hook() {
  rm -f "$HOOK_DEST"
}

menu_polish_action() {
  printf '%s/scripts/omarchy-polish' "$PLUGIN_DIR"
}

upsert_menu() {
  local action_bin
  action_bin=$(menu_polish_action)
  mkdir -p "$(dirname "$MENU_FILE")"
  python3 - "$MENU_FILE" "$action_bin" <<'PY'
import json, pathlib, re, sys

path = pathlib.Path(sys.argv[1])
action_bin = sys.argv[2]
header = """{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id.
  // Existing fields are kept unless overridden.

"""

def strip_jsonc(raw: str) -> str:
    out = []
    for line in raw.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("//"):
            continue
        out.append(line)
    text = "\n".join(out)
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    return text

data = {}
if path.exists():
    raw = path.read_text()
    stripped = strip_jsonc(raw).strip()
    if stripped:
        data = json.loads(stripped)
        if not isinstance(data, dict):
            data = {}

# Drop the old Smart Tweaks row and the Theme action-only override that
# made the Style menu show "style.theme" (empty label falls back to the id).
data.pop("style.theme", None)
data.pop("style.smart-tweaks", None)

data["style.polish"] = {
    "icon": "󰃌",
    "label": "Polish",
    "description": "Slight rounding, tight top gaps, and a soft hue-matched glow",
    "aliases": ["polish", "smart tweaks", "window chrome", "theme polish"],
    "action": f"{action_bin} toggle",
    "checked": f"{action_bin} --enabled",
}

body = json.dumps(data, indent=2, ensure_ascii=False)
# json.dumps already quoted the action strings; keep JSONC trailing comma style.
if body.endswith("\n}"):
    pass
path.write_text(header + body[1:] + "\n")
PY
}

remove_menu() {
  [[ -f $MENU_FILE ]] || return 0
  python3 - "$MENU_FILE" <<'PY'
import json, pathlib, re, sys
path = pathlib.Path(sys.argv[1])
raw = path.read_text()

def strip_jsonc(raw: str) -> str:
    out = []
    for line in raw.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("//"):
            continue
        out.append(line)
    text = "\n".join(out)
    return re.sub(r",(\s*[}\]])", r"\1", text)

data = json.loads(strip_jsonc(raw))
if not isinstance(data, dict):
    raise SystemExit(0)
changed = False
for key in ("style.polish", "style.smart-tweaks", "style.theme"):
    if key in data:
        data.pop(key)
        changed = True
if not changed:
    raise SystemExit(0)
header = """{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id.
  // Existing fields are kept unless overridden.

"""
body = json.dumps(data, indent=2, ensure_ascii=False)
path.write_text(header + body[1:] + "\n")
PY
}

wired() {
  [[ -f $HYPR_SNIPPET ]] && grep -q 'require("hypr.polish")' "$HYPRLAND_LUA" 2>/dev/null
}

cmd_status() {
  echo "plugin:  $PLUGIN_DIR"
  echo "config:  $POLISH_TOML"
  if wired; then
    echo "wired:   yes"
  else
    echo "wired:   no"
  fi
  if applied_now; then
    echo "polish:  on"
  else
    echo "polish:  off"
  fi
}

cmd_on() {
  ensure_polish_toml
  set_applied true
  reload_hypr
  if [[ ${1:-} != "--quiet" ]]; then
    notify "Polish on"
  fi
}

cmd_off() {
  if [[ -f $POLISH_TOML ]]; then
    set_applied false
  fi
  reload_hypr
  notify "Polish off"
}

cmd_toggle() {
  if applied_now; then
    cmd_off
  else
    cmd_on
  fi
}

cmd_refresh() {
  applied_now || exit 0
  reload_hypr
}

cmd_apply() {
  ensure_polish_toml
  migrate_theme_tweaks
  restore_stock_looknfeel
  ensure_hypr_snippet
  install_cli_link
  install_hook
  upsert_menu
  set_applied true
  reload_hypr
  local errors
  errors=$(hyprctl configerrors 2>/dev/null || true)
  if [[ -n ${errors// /} && $errors != "nothing" ]]; then
    echo "hyprctl configerrors:" >&2
    echo "$errors" >&2
  fi
  echo "Polish is on. Super+Space → Style → Polish to toggle."
}

cmd_unapply() {
  local purge=0
  if [[ ${1:-} == "--purge" ]]; then
    purge=1
  fi
  if [[ -f $POLISH_TOML ]]; then
    set_applied false
  fi
  remove_hypr_snippet
  remove_hook
  remove_menu
  remove_cli_link
  reload_hypr
  if (( purge )); then
    local plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
    if [[ -d $plugins_dir/$PLUGIN_ID ]]; then
      omarchy plugin remove "$PLUGIN_ID" --yes 2>/dev/null || rm -rf "$plugins_dir/$PLUGIN_ID"
    fi
    echo "Removed Polish. Stock theme chrome is restored."
  else
    echo "Unapplied Polish. Re-apply with: $SCRIPT_DIR/omarchy-polish apply"
  fi
}

usage() {
  cat <<EOF
Usage: omarchy-polish {apply|unapply [--purge]|on|off|toggle|refresh|status|--enabled}

  apply             Wire Hyprland, the Style menu, and a theme-set hook, then enable
  unapply           Remove wiring and turn chrome off
  unapply --purge   Also remove the payton.polish plugin
  on | off | toggle Enable or disable chrome (Style → Polish)
  refresh           Reload Hyprland if Polish is on (theme-set hook)
  status            Show whether Polish is wired and enabled
  --enabled         Exit 0 if chrome is on
EOF
}

case "${1:-}" in
  apply) cmd_apply ;;
  unapply) cmd_unapply "${2:-}" ;;
  on | apply-chrome)
    cmd_on "${2:-}"
    ;;
  off | clear) cmd_off ;;
  toggle) cmd_toggle ;;
  refresh) cmd_refresh ;;
  status) cmd_status ;;
  --enabled)
    applied_now
    ;;
  -h | --help | help | "")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
