#!/bin/bash
# Apply, toggle, or remove Patina window chrome on this Omarchy machine.

set -euo pipefail

PLUGIN_ID="payton.patina"
HYPR_MARK_BEGIN="-- omarchy-patina begin"
HYPR_MARK_END="-- omarchy-patina end"
OLD_HYPR_MARK_BEGIN="-- omarchy-polish begin"
OLD_HYPR_MARK_END="-- omarchy-polish end"

SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
PLUGIN_DIR=$(cd -- "$(dirname "$SCRIPT_DIR")" && pwd)
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
PATINA_TOML="$CONFIG_HOME/omarchy/patina.toml"
LEGACY_POLISH_TOML="$CONFIG_HOME/omarchy/polish.toml"
TWEAKS_TOML="$CONFIG_HOME/omarchy/theme-tweaks.toml"
MENU_FILE="$CONFIG_HOME/omarchy/extensions/omarchy-menu.jsonc"
HYPR_DIR="$CONFIG_HOME/hypr"
HYPRLAND_LUA="$HYPR_DIR/hyprland.lua"
HYPR_SNIPPET="$HYPR_DIR/patina.lua"
LEGACY_HYPR_SNIPPET="$HYPR_DIR/polish.lua"
LOCAL_BIN="$HOME/.local/bin"
HOOK_DEST="$CONFIG_HOME/omarchy/hooks/theme-set.d/patina"
LEGACY_HOOK="$CONFIG_HOME/omarchy/hooks/theme-set.d/polish"
LIB="$SCRIPT_DIR/lib.py"
TOML_CREATED=0

fail() {
  echo "omarchy-patina: $*" >&2
  exit 1
}

notify() {
  local msg="$1"
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send "$msg" -t 1800 >/dev/null 2>&1 || true
}

reload_hypr() {
  hyprctl reload >/dev/null 2>&1 || true
}

applied_now() {
  [[ -f $PATINA_TOML ]] || return 1
  python3 - "$PATINA_TOML" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
in_root = True
for raw in path.read_text().splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("["):
        in_root = False
        continue
    if in_root and line.split("=", 1)[0].strip() == "applied":
        value = line.split("=", 1)[1].split("#", 1)[0].strip()
        sys.exit(0 if value == "true" else 1)
sys.exit(1)
PY
}

set_applied() {
  local value="$1"
  mkdir -p "$(dirname "$PATINA_TOML")"
  python3 - "$PATINA_TOML" "$value" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
val = sys.argv[2]
text = path.read_text() if path.exists() else ""
lines = text.splitlines(keepends=True)
out = []
done = False
seen_section = False
for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and not stripped.startswith("[."):
        if not done and not seen_section:
            out.append(f"applied = {val}\n")
            done = True
        seen_section = True
        out.append(line)
        continue
    if stripped.startswith("applied") and "=" in stripped and not seen_section:
        if not done:
            prefix = line[: len(line) - len(line.lstrip())]
            newline = "\n" if line.endswith("\n") else ""
            out.append(f"{prefix}applied = {val}{newline}")
            done = True
        continue
    out.append(line)
if not done:
    body = "".join(out)
    extra = f"applied = {val}\n"
    if body and not body.endswith("\n"):
        extra = "\n" + extra
    out.append(extra)
path.write_text("".join(out))
PY
}

ensure_patina_toml() {
  mkdir -p "$(dirname "$PATINA_TOML")"
  if [[ -f $PATINA_TOML ]]; then
    TOML_CREATED=0
    return
  fi
  TOML_CREATED=1
  if [[ -f $LEGACY_POLISH_TOML ]]; then
    cp "$LEGACY_POLISH_TOML" "$PATINA_TOML"
    python3 - "$PATINA_TOML" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
text = text.replace("Polish", "Patina").replace("polish.toml", "patina.toml").replace("omarchy-polish", "omarchy-patina")
path.write_text(text)
PY
    rm -f "$LEGACY_POLISH_TOML"
    return
  fi
  if [[ -f $PLUGIN_DIR/config/patina.toml ]]; then
    cp "$PLUGIN_DIR/config/patina.toml" "$PATINA_TOML"
  else
    printf 'applied = true\n' >"$PATINA_TOML"
  fi
}

migrate_theme_tweaks() {
  [[ -f $TWEAKS_TOML ]] || return 0
  python3 "$LIB" migrate-tweaks "$TWEAKS_TOML"
}

strip_hypr_marks() {
  local begin="$1"
  local end="$2"
  [[ -f $HYPRLAND_LUA ]] || return 0
  python3 - "$HYPRLAND_LUA" "$begin" "$end" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
begin, end = sys.argv[2], sys.argv[3]
lines = path.read_text().splitlines(keepends=True)
out, skipping = [], False
changed = False
for line in lines:
    if begin in line:
        skipping = True
        changed = True
        continue
    if skipping:
        if end in line:
            skipping = False
        continue
    out.append(line)
if changed:
    path.write_text("".join(out))
PY
}

ensure_hypr_snippet() {
  mkdir -p "$HYPR_DIR"
  [[ -f $PLUGIN_DIR/hypr/patina.lua ]] || fail "missing $PLUGIN_DIR/hypr/patina.lua"
  cp "$PLUGIN_DIR/hypr/patina.lua" "$HYPR_SNIPPET"
  rm -f "$LEGACY_HYPR_SNIPPET"
  [[ -f $HYPRLAND_LUA ]] || fail "missing $HYPRLAND_LUA"
  strip_hypr_marks "$OLD_HYPR_MARK_BEGIN" "$OLD_HYPR_MARK_END"
  strip_hypr_marks "$HYPR_MARK_BEGIN" "$HYPR_MARK_END"

  python3 - "$HYPRLAND_LUA" "$HYPR_MARK_BEGIN" "$HYPR_MARK_END" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
begin, end = sys.argv[2], sys.argv[3]
text = path.read_text().rstrip() + "\n"
if 'require("hypr.patina")' not in text:
    text = text.rstrip() + f"\n\n{begin}\nrequire(\"hypr.patina\")\n{end}\n"
    path.write_text(text)
PY
}

remove_hypr_snippet() {
  rm -f "$HYPR_SNIPPET" "$LEGACY_HYPR_SNIPPET"
  strip_hypr_marks "$HYPR_MARK_BEGIN" "$HYPR_MARK_END"
  strip_hypr_marks "$OLD_HYPR_MARK_BEGIN" "$OLD_HYPR_MARK_END"
}

install_cli_link() {
  mkdir -p "$LOCAL_BIN"
  ln -sfn "$PLUGIN_DIR/scripts/omarchy-patina" "$LOCAL_BIN/omarchy-patina"
  if [[ -e $LOCAL_BIN/omarchy-polish && ! -L $LOCAL_BIN/omarchy-polish ]]; then
    echo "omarchy-patina: leaving existing $LOCAL_BIN/omarchy-polish in place"
  else
    ln -sfn "$LOCAL_BIN/omarchy-patina" "$LOCAL_BIN/omarchy-polish"
  fi
  local tweaks="$LOCAL_BIN/omarchy-theme-tweaks"
  if [[ -e $tweaks ]] && ! grep -Eq 'omarchy-patina|omarchy-polish|Smart Tweaks' "$tweaks"; then
    echo "omarchy-patina: leaving existing $tweaks in place"
    return
  fi
  cat >"$tweaks" <<'WRAP'
#!/bin/bash
# Back-compat for the old Smart Tweaks command name.
cmd="${1:-toggle}"
shift || true
case "$cmd" in
  apply | on) exec "$(dirname "$0")/omarchy-patina" on "$@" ;;
  *) exec "$(dirname "$0")/omarchy-patina" "$cmd" "$@" ;;
esac
WRAP
  chmod 755 "$tweaks"
}

remove_cli_link() {
  if [[ -L $LOCAL_BIN/omarchy-patina ]]; then
    local target
    target=$(readlink -f "$LOCAL_BIN/omarchy-patina" || true)
    if [[ $target == *"/payton.patina/"* || $target == *"/omarchy-patina/"* || $target == *"/omarchy-polish/"* ]]; then
      rm -f "$LOCAL_BIN/omarchy-patina"
    fi
  fi
  if [[ -L $LOCAL_BIN/omarchy-polish ]]; then
    rm -f "$LOCAL_BIN/omarchy-polish"
  fi
  if [[ -f $LOCAL_BIN/omarchy-theme-tweaks ]] && grep -Eq 'omarchy-patina|omarchy-polish' "$LOCAL_BIN/omarchy-theme-tweaks"; then
    rm -f "$LOCAL_BIN/omarchy-theme-tweaks"
  fi
}

install_hook() {
  local src="$PLUGIN_DIR/hooks/patina"
  [[ -f $src ]] || fail "missing $src"
  mkdir -p "$(dirname "$HOOK_DEST")"
  cp "$src" "$HOOK_DEST"
  chmod 755 "$HOOK_DEST"
  rm -f "$LEGACY_HOOK"
}

remove_hook() {
  rm -f "$HOOK_DEST" "$LEGACY_HOOK"
}

upsert_menu() {
  mkdir -p "$(dirname "$MENU_FILE")"
  python3 "$LIB" menu-upsert "$MENU_FILE" "$PLUGIN_DIR/scripts/omarchy-patina"
}

remove_menu() {
  [[ -f $MENU_FILE ]] || return 0
  python3 "$LIB" menu-remove "$MENU_FILE"
}

wired() {
  [[ -f $HYPR_SNIPPET ]] && grep -q 'require("hypr.patina")' "$HYPRLAND_LUA" 2>/dev/null
}

cmd_status() {
  echo "plugin:  $PLUGIN_DIR"
  echo "config:  $PATINA_TOML"
  if wired; then
    echo "wired:   yes"
  else
    echo "wired:   no"
  fi
  if applied_now; then
    echo "patina:  on"
  else
    echo "patina:  off"
  fi
  echo "gaps:    $(python3 "$LIB" gaps-get "$PATINA_TOML")"
  echo "corners: $(python3 "$LIB" corners-get "$PATINA_TOML")"
}

cmd_get() {
  python3 "$LIB" state-get "$PATINA_TOML"
}

json_payload() {
  # ${1:-{}} is not safe: bash treats the inner } as the end of the
  # expansion, so a real JSON object is passed on with a trailing }.
  if [[ -n ${1-} ]]; then
    printf '%s' "$1"
  else
    printf '{}'
  fi
}

cmd_set() {
  ensure_patina_toml
  if [[ ${1:-} == --json ]]; then
    python3 "$LIB" state-set "$PATINA_TOML" "$(json_payload "${2-}")"
  else
    python3 "$LIB" state-set-args "$PATINA_TOML" "$@"
  fi
  reload_hypr
}

cmd_panel() {
  omarchy-shell shell summon payton.patina '{}' >/dev/null 2>&1 ||
    fail "could not open the Patina panel"
}

cmd_corners() {
  local preset="${1:-}"
  case "$preset" in
    "" | --get)
      python3 "$LIB" corners-get "$PATINA_TOML"
      ;;
    --is)
      python3 "$LIB" corners-is "$PATINA_TOML" "${2:-}"
      ;;
    sharp | soft | round)
      ensure_patina_toml
      python3 "$LIB" corners-set "$PATINA_TOML" "$preset"
      reload_hypr
      notify "Corners: $preset"
      echo "Corners: $preset"
      ;;
    *)
      fail "unknown corner preset '$preset' (sharp, soft, round)"
      ;;
  esac
}

cmd_gaps() {
  local preset="${1:-}"
  case "$preset" in
    "" | --get)
      python3 "$LIB" gaps-get "$PATINA_TOML"
      ;;
    --is)
      python3 "$LIB" gaps-is "$PATINA_TOML" "${2:-}"
      ;;
    tight | default | loose)
      ensure_patina_toml
      python3 "$LIB" gaps-set "$PATINA_TOML" "$preset"
      reload_hypr
      local label="$preset"
      if [[ $preset == default ]]; then
        label="default (Omarchy)"
      fi
      notify "Gaps: $label"
      echo "Gaps: $label"
      ;;
    *)
      fail "unknown gap preset '$preset' (tight, default, loose)"
      ;;
  esac
}

cmd_on() {
  ensure_patina_toml
  set_applied true
  reload_hypr
  if [[ ${1:-} != "--quiet" ]]; then
    notify "Patina on"
  fi
}

cmd_off() {
  if [[ -f $PATINA_TOML ]]; then
    set_applied false
  fi
  reload_hypr
  notify "Patina off"
}

cmd_toggle() {
  if applied_now; then
    cmd_off
  else
    cmd_on
  fi
}

cmd_refresh() {
  applied_now || exit 0
  reload_hypr
}

cmd_apply() {
  ensure_patina_toml
  rm -f "$LEGACY_POLISH_TOML"
  if (( TOML_CREATED )); then
    python3 "$LIB" write-flags "$PATINA_TOML" "$HYPR_DIR"
  fi
  migrate_theme_tweaks
  ensure_hypr_snippet
  install_cli_link
  install_hook
  upsert_menu
  set_applied true
  reload_hypr
  local errors
  errors=$(hyprctl configerrors 2>/dev/null || true)
  if [[ -n ${errors// /} && $errors != "nothing" ]]; then
    echo "hyprctl configerrors:" >&2
    echo "$errors" >&2
  fi
  echo "Patina is on. Super+Space → Style → Patina opens the control panel."
}

cmd_unapply() {
  local purge=0
  if [[ ${1:-} == "--purge" ]]; then
    purge=1
  fi
  if [[ -f $PATINA_TOML ]]; then
    set_applied false
  fi
  remove_hypr_snippet
  remove_hook
  remove_menu
  remove_cli_link
  reload_hypr
  if (( purge )); then
    local plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
    if [[ -d $plugins_dir/$PLUGIN_ID ]]; then
      omarchy plugin remove "$PLUGIN_ID" --yes 2>/dev/null || rm -rf "$plugins_dir/$PLUGIN_ID"
    fi
    echo "Removed Patina. Stock theme chrome is restored."
  else
    echo "Unapplied Patina. Re-apply with: $SCRIPT_DIR/omarchy-patina apply"
  fi
}

usage() {
  cat <<EOF
Usage: omarchy-patina {apply|unapply [--purge]|on|off|toggle|panel|gaps|corners|get|set|refresh|status|--enabled}

  apply             Wire Hyprland, the Style menu, and a theme-set hook, then enable
  unapply           Remove wiring and turn chrome off
  unapply --purge   Also remove the payton.patina plugin
  panel             Open the Patina control panel
  on | off | toggle Enable or disable chrome
  gaps [tight|default|loose]     Gap preset
  corners [sharp|soft|round]     Corner radius preset
  get --json        Current settings as JSON
  set [--json]      Write settings and reload Hyprland
  refresh           Reload Hyprland if Patina is on
  status            Show whether Patina is wired and enabled
  --enabled         Exit 0 if chrome is on
EOF
}

case "${1:-}" in
  apply) cmd_apply ;;
  unapply) cmd_unapply "${2:-}" ;;
  on | apply-chrome)
    cmd_on "${2:-}"
    ;;
  off | clear) cmd_off ;;
  toggle) cmd_toggle ;;
  panel) cmd_panel ;;
  gaps) cmd_gaps "${2:-}" "${3:-}" ;;
  corners) cmd_corners "${2:-}" "${3:-}" ;;
  get)
    cmd_get
    ;;
  set)
    shift
    cmd_set "$@"
    ;;
  refresh) cmd_refresh ;;
  status) cmd_status ;;
  --enabled)
    applied_now
    ;;
  -h | --help | help | "")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
