#!/bin/bash
# Apply, toggle, or remove Patina window chrome on this Omarchy machine.

set -euo pipefail

PLUGIN_ID="payton.patina"
HYPR_MARK_BEGIN="-- omarchy-patina begin"
HYPR_MARK_END="-- omarchy-patina end"
OLD_HYPR_MARK_BEGIN="-- omarchy-polish begin"
OLD_HYPR_MARK_END="-- omarchy-polish end"

SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
PLUGIN_DIR=$(cd -- "$(dirname "$SCRIPT_DIR")" && pwd)
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
PATINA_TOML="$CONFIG_HOME/omarchy/patina.toml"
LEGACY_POLISH_TOML="$CONFIG_HOME/omarchy/polish.toml"
TWEAKS_TOML="$CONFIG_HOME/omarchy/theme-tweaks.toml"
MENU_FILE="$CONFIG_HOME/omarchy/extensions/omarchy-menu.jsonc"
HYPR_DIR="$CONFIG_HOME/hypr"
HYPRLAND_LUA="$HYPR_DIR/hyprland.lua"
HYPR_SNIPPET="$HYPR_DIR/patina.lua"
LEGACY_HYPR_SNIPPET="$HYPR_DIR/polish.lua"
LOCAL_BIN="$HOME/.local/bin"
HOOK_DEST="$CONFIG_HOME/omarchy/hooks/theme-set.d/patina"
LEGACY_HOOK="$CONFIG_HOME/omarchy/hooks/theme-set.d/polish"
STOCK_LOOKNFEEL="/usr/share/omarchy/config/hypr/looknfeel.lua"

fail() {
  echo "omarchy-patina: $*" >&2
  exit 1
}

notify() {
  local msg="$1"
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send "$msg" -t 1800 >/dev/null 2>&1 || true
}

reload_hypr() {
  hyprctl reload >/dev/null 2>&1 || true
}

applied_now() {
  [[ -f $PATINA_TOML ]] || return 1
  python3 - "$PATINA_TOML" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
in_root = True
for raw in path.read_text().splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("["):
        in_root = False
        continue
    if in_root and line.split("=", 1)[0].strip() == "applied":
        value = line.split("=", 1)[1].split("#", 1)[0].strip()
        sys.exit(0 if value == "true" else 1)
sys.exit(1)
PY
}

set_applied() {
  local value="$1"
  mkdir -p "$(dirname "$PATINA_TOML")"
  python3 - "$PATINA_TOML" "$value" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
val = sys.argv[2]
text = path.read_text() if path.exists() else ""
lines = text.splitlines(keepends=True)
out = []
done = False
seen_section = False
for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and not stripped.startswith("[."):
        if not done and not seen_section:
            out.append(f"applied = {val}\n")
            done = True
        seen_section = True
        out.append(line)
        continue
    if stripped.startswith("applied") and "=" in stripped and not seen_section:
        if not done:
            prefix = line[: len(line) - len(line.lstrip())]
            newline = "\n" if line.endswith("\n") else ""
            out.append(f"{prefix}applied = {val}{newline}")
            done = True
        continue
    out.append(line)
if not done:
    body = "".join(out)
    extra = f"applied = {val}\n"
    if body and not body.endswith("\n"):
        extra = "\n" + extra
    out.append(extra)
path.write_text("".join(out))
PY
}

ensure_patina_toml() {
  mkdir -p "$(dirname "$PATINA_TOML")"
  if [[ -f $PATINA_TOML ]]; then
    return
  fi
  if [[ -f $LEGACY_POLISH_TOML ]]; then
    cp "$LEGACY_POLISH_TOML" "$PATINA_TOML"
    python3 - "$PATINA_TOML" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
text = text.replace("Polish", "Patina").replace("polish.toml", "patina.toml").replace("omarchy-polish", "omarchy-patina")
path.write_text(text)
PY
    rm -f "$LEGACY_POLISH_TOML"
    return
  fi
  if [[ -f $PLUGIN_DIR/config/patina.toml ]]; then
    cp "$PLUGIN_DIR/config/patina.toml" "$PATINA_TOML"
  else
    printf 'applied = true\n' >"$PATINA_TOML"
  fi
}

migrate_theme_tweaks() {
  [[ -f $TWEAKS_TOML ]] || return 0
  python3 - "$TWEAKS_TOML" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
chrome_keys = {
    "rounding", "border_size", "gaps_out_top", "gaps_out_right",
    "gaps_out_bottom", "gaps_out_left", "inactive_mix", "saturate_accent",
    "glow", "glow_range", "glow_power", "glow_alpha", "inner_glow_range",
    "inner_glow_alpha",
}
kept = []
in_auto = False
had_chrome = False
for raw in text.splitlines(keepends=True):
    stripped = raw.strip()
    if stripped.startswith("["):
        name = stripped.strip("[]").strip()
        in_auto = name == "auto"
        kept.append(raw)
        continue
    key = stripped.split("=", 1)[0].strip() if "=" in stripped else ""
    if not in_auto and key in chrome_keys:
        had_chrome = True
        continue
    if not in_auto and key == "applied":
        continue
    kept.append(raw)

body = "".join(kept)
if "polish.toml" in body or "Style → Polish" in body:
    body = body.replace("polish.toml", "patina.toml").replace("Style → Polish", "Style → Patina")
    path.write_text(body)
elif had_chrome:
    header = (
        "# Auto light/dark theme swap at sunrise and sunset.\n"
        "# Window chrome lives in patina.toml (Style → Patina).\n"
    )
    if "patina.toml" not in body:
        body = header + "\n" + body.lstrip("\n")
    path.write_text(body)
PY
}

looknfeel_has_old_recipe() {
  [[ -f $HYPR_DIR/looknfeel.lua ]] || return 1
  grep -q "theme-tweaks.toml\|omarchy-polish\|omarchy-patina\|parse_simple_toml" "$HYPR_DIR/looknfeel.lua"
}

restore_stock_looknfeel() {
  looknfeel_has_old_recipe || return 0
  [[ -f $STOCK_LOOKNFEEL ]] || return 0
  local bak="$HYPR_DIR/looknfeel.lua.bak.patina.$(date +%s)"
  cp "$HYPR_DIR/looknfeel.lua" "$bak"
  cp "$STOCK_LOOKNFEEL" "$HYPR_DIR/looknfeel.lua"
  echo "Restored stock looknfeel.lua (backup $bak)"
}

strip_hypr_marks() {
  local begin="$1"
  local end="$2"
  [[ -f $HYPRLAND_LUA ]] || return 0
  python3 - "$HYPRLAND_LUA" "$begin" "$end" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
begin, end = sys.argv[2], sys.argv[3]
lines = path.read_text().splitlines(keepends=True)
out, skipping = [], False
changed = False
for line in lines:
    if begin in line:
        skipping = True
        changed = True
        continue
    if skipping:
        if end in line:
            skipping = False
        continue
    out.append(line)
if changed:
    path.write_text("".join(out))
PY
}

ensure_hypr_snippet() {
  mkdir -p "$HYPR_DIR"
  [[ -f $PLUGIN_DIR/hypr/patina.lua ]] || fail "missing $PLUGIN_DIR/hypr/patina.lua"
  cp "$PLUGIN_DIR/hypr/patina.lua" "$HYPR_SNIPPET"
  rm -f "$LEGACY_HYPR_SNIPPET"
  [[ -f $HYPRLAND_LUA ]] || fail "missing $HYPRLAND_LUA"
  strip_hypr_marks "$OLD_HYPR_MARK_BEGIN" "$OLD_HYPR_MARK_END"
  strip_hypr_marks "$HYPR_MARK_BEGIN" "$HYPR_MARK_END"

  python3 - "$HYPRLAND_LUA" "$HYPR_MARK_BEGIN" "$HYPR_MARK_END" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
begin, end = sys.argv[2], sys.argv[3]
text = path.read_text().rstrip() + "\n"
if 'require("hypr.patina")' not in text:
    text = text.rstrip() + f"\n\n{begin}\nrequire(\"hypr.patina\")\n{end}\n"
    path.write_text(text)
PY
}

remove_hypr_snippet() {
  rm -f "$HYPR_SNIPPET" "$LEGACY_HYPR_SNIPPET"
  strip_hypr_marks "$HYPR_MARK_BEGIN" "$HYPR_MARK_END"
  strip_hypr_marks "$OLD_HYPR_MARK_BEGIN" "$OLD_HYPR_MARK_END"
}

install_cli_link() {
  mkdir -p "$LOCAL_BIN"
  ln -sfn "$PLUGIN_DIR/scripts/omarchy-patina" "$LOCAL_BIN/omarchy-patina"
  ln -sfn "$LOCAL_BIN/omarchy-patina" "$LOCAL_BIN/omarchy-polish"
  cat >"$LOCAL_BIN/omarchy-theme-tweaks" <<'WRAP'
#!/bin/bash
# Back-compat for the old Smart Tweaks command name.
cmd="${1:-toggle}"
shift || true
case "$cmd" in
  apply | on) exec "$(dirname "$0")/omarchy-patina" on "$@" ;;
  *) exec "$(dirname "$0")/omarchy-patina" "$cmd" "$@" ;;
esac
WRAP
  chmod 755 "$LOCAL_BIN/omarchy-theme-tweaks"
}

remove_cli_link() {
  if [[ -L $LOCAL_BIN/omarchy-patina ]]; then
    local target
    target=$(readlink -f "$LOCAL_BIN/omarchy-patina" || true)
    if [[ $target == *"/payton.patina/"* || $target == *"/omarchy-patina/"* || $target == *"/omarchy-polish/"* ]]; then
      rm -f "$LOCAL_BIN/omarchy-patina"
    fi
  fi
  if [[ -L $LOCAL_BIN/omarchy-polish ]]; then
    rm -f "$LOCAL_BIN/omarchy-polish"
  fi
  if [[ -f $LOCAL_BIN/omarchy-theme-tweaks ]] && grep -Eq 'omarchy-patina|omarchy-polish' "$LOCAL_BIN/omarchy-theme-tweaks"; then
    rm -f "$LOCAL_BIN/omarchy-theme-tweaks"
  fi
}

install_hook() {
  local src="$PLUGIN_DIR/hooks/patina"
  [[ -f $src ]] || fail "missing $src"
  mkdir -p "$(dirname "$HOOK_DEST")"
  cp "$src" "$HOOK_DEST"
  chmod 755 "$HOOK_DEST"
  rm -f "$LEGACY_HOOK"
}

remove_hook() {
  rm -f "$HOOK_DEST" "$LEGACY_HOOK"
}

upsert_menu() {
  local action_bin="$PLUGIN_DIR/scripts/omarchy-patina"
  mkdir -p "$(dirname "$MENU_FILE")"
  python3 - "$MENU_FILE" "$action_bin" <<'PY'
import json, pathlib, re, sys

path = pathlib.Path(sys.argv[1])
action_bin = sys.argv[2]
header = """{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id.
  // Existing fields are kept unless overridden.

"""

def strip_jsonc(raw: str) -> str:
    out = []
    for line in raw.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("//"):
            continue
        out.append(line)
    text = "\n".join(out)
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    return text

data = {}
if path.exists():
    raw = path.read_text()
    stripped = strip_jsonc(raw).strip()
    if stripped:
        data = json.loads(stripped)
        if not isinstance(data, dict):
            data = {}

# Drop the Theme action-only override that made Style show "style.theme",
# plus old Smart Tweaks / Polish rows.
for key in ("style.theme", "style.smart-tweaks", "style.polish"):
    data.pop(key, None)

data["style.patina"] = {
    "icon": "󰃌",
    "label": "Patina",
    "description": "Slight rounding, tight top gaps, and a soft hue-matched glow",
    "aliases": ["patina", "polish", "smart tweaks", "window chrome", "theme polish"],
    "action": f"{action_bin} toggle",
    "checked": f"{action_bin} --enabled",
}

body = json.dumps(data, indent=2, ensure_ascii=False)
path.write_text(header + body[1:] + "\n")
PY
}

remove_menu() {
  [[ -f $MENU_FILE ]] || return 0
  python3 - "$MENU_FILE" <<'PY'
import json, pathlib, re, sys
path = pathlib.Path(sys.argv[1])
raw = path.read_text()

def strip_jsonc(raw: str) -> str:
    out = []
    for line in raw.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("//"):
            continue
        out.append(line)
    text = "\n".join(out)
    return re.sub(r",(\s*[}\]])", r"\1", text)

data = json.loads(strip_jsonc(raw))
if not isinstance(data, dict):
    raise SystemExit(0)
changed = False
for key in ("style.patina", "style.polish", "style.smart-tweaks", "style.theme"):
    if key in data:
        data.pop(key)
        changed = True
if not changed:
    raise SystemExit(0)
header = """{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id.
  // Existing fields are kept unless overridden.

"""
body = json.dumps(data, indent=2, ensure_ascii=False)
path.write_text(header + body[1:] + "\n")
PY
}

wired() {
  [[ -f $HYPR_SNIPPET ]] && grep -q 'require("hypr.patina")' "$HYPRLAND_LUA" 2>/dev/null
}

cmd_status() {
  echo "plugin:  $PLUGIN_DIR"
  echo "config:  $PATINA_TOML"
  if wired; then
    echo "wired:   yes"
  else
    echo "wired:   no"
  fi
  if applied_now; then
    echo "patina:  on"
  else
    echo "patina:  off"
  fi
}

cmd_on() {
  ensure_patina_toml
  set_applied true
  reload_hypr
  if [[ ${1:-} != "--quiet" ]]; then
    notify "Patina on"
  fi
}

cmd_off() {
  if [[ -f $PATINA_TOML ]]; then
    set_applied false
  fi
  reload_hypr
  notify "Patina off"
}

cmd_toggle() {
  if applied_now; then
    cmd_off
  else
    cmd_on
  fi
}

cmd_refresh() {
  applied_now || exit 0
  reload_hypr
}

cmd_apply() {
  ensure_patina_toml
  rm -f "$LEGACY_POLISH_TOML"
  migrate_theme_tweaks
  restore_stock_looknfeel
  ensure_hypr_snippet
  install_cli_link
  install_hook
  upsert_menu
  set_applied true
  reload_hypr
  local errors
  errors=$(hyprctl configerrors 2>/dev/null || true)
  if [[ -n ${errors// /} && $errors != "nothing" ]]; then
    echo "hyprctl configerrors:" >&2
    echo "$errors" >&2
  fi
  echo "Patina is on. Super+Space → Style → Patina to toggle."
}

cmd_unapply() {
  local purge=0
  if [[ ${1:-} == "--purge" ]]; then
    purge=1
  fi
  if [[ -f $PATINA_TOML ]]; then
    set_applied false
  fi
  remove_hypr_snippet
  remove_hook
  remove_menu
  remove_cli_link
  reload_hypr
  if (( purge )); then
    local plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
    if [[ -d $plugins_dir/$PLUGIN_ID ]]; then
      omarchy plugin remove "$PLUGIN_ID" --yes 2>/dev/null || rm -rf "$plugins_dir/$PLUGIN_ID"
    fi
    echo "Removed Patina. Stock theme chrome is restored."
  else
    echo "Unapplied Patina. Re-apply with: $SCRIPT_DIR/omarchy-patina apply"
  fi
}

usage() {
  cat <<EOF
Usage: omarchy-patina {apply|unapply [--purge]|on|off|toggle|refresh|status|--enabled}

  apply             Wire Hyprland, the Style menu, and a theme-set hook, then enable
  unapply           Remove wiring and turn chrome off
  unapply --purge   Also remove the payton.patina plugin
  on | off | toggle Enable or disable chrome (Style → Patina)
  refresh           Reload Hyprland if Patina is on (theme-set hook)
  status            Show whether Patina is wired and enabled
  --enabled         Exit 0 if chrome is on
EOF
}

case "${1:-}" in
  apply) cmd_apply ;;
  unapply) cmd_unapply "${2:-}" ;;
  on | apply-chrome)
    cmd_on "${2:-}"
    ;;
  off | clear) cmd_off ;;
  toggle) cmd_toggle ;;
  refresh) cmd_refresh ;;
  status) cmd_status ;;
  --enabled)
    applied_now
    ;;
  -h | --help | help | "")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
